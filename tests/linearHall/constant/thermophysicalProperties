FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Argon as a calorically perfect ideal gas. The seed (1% K) and the electrons
// are neglected in the gas properties; the plasma state comes from Elmer.
thermoType
{
    type            hePsiThermo;
    mixture         pureMixture;
    transport       sutherland;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   39.948;     // g/mol
    }
    thermodynamics
    {
        Cp          520.3;      // J/(kg K), monatomic 5/2 R
        Hf          0;
    }
    transport
    {
        // Viscosity mu = As sqrt(T)/(1 + Ts/T), fitted to argon at 300 K
        // (2.27e-5 Pa s) and 1500 K (6.79e-5 Pa s); 9.1e-5 Pa s at 2500 K.
        // Thermal conductivity follows from the modified Eucken relation,
        // which for a monatomic gas gives Pr = 2/3.
        As          1.915e-06;  // Pa s / K^0.5
        Ts          138.3;      // K
    }
}


