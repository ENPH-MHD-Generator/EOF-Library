FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type                 hePsiThermo;
    mixture              pureMixture;
    transport            sutherland;
    thermo               hConst;
    equationOfState      perfectGas;
    specie               specie;
    energy               sensibleEnthalpy;
}
mixture
{
    specie
    {
        molWeight            39.948;
    }
    thermodynamics
    {
        Cp                   520.3;
        Hf                   0;
    }
    transport
    {
        As                   1.915e-06;
        Ts                   138.3;
    }
}
