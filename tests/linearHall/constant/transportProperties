FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel Newtonian;

// Argon gas properties at 1500 K and 1 atm (aligned with inlet T)
rho  0.325;      // kg/m3
nu   2.13e-4;    // m2/s

// Thermal properties
cp   520.0;    // Specific heat capacity (J/kg/K) for argon
kappa 0.0866;  // Thermal conductivity (W/m/K) at 2500 K

// Electrical conductivity, ionization fraction and Hall coefficient come from
// the seeded-plasma (Saha) model in Elmer; configure it under "plasma:" in the
// experiment YAML. How often Elmer is updated is set under "coupling:" and
// written to constant/couplingProperties.

