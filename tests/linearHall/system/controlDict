FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application          mhdLinearHall;
startFrom            startTime;
startTime            0;
stopAt               endTime;
endTime              1e-4;
deltaT               0.1;
writeControl         adjustableRunTime;
writeInterval        1e-5;
adjustTimeStep       yes;
purgeWrite           0;
maxCo                0.8;
maxDeltaT            1;
functions
{
}
