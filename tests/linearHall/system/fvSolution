FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
solvers
{
    // potentialFoam (case preparation): initial velocity field
    Phi
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
    }

    p
    {
        solver          GAMG;
        tolerance       1e-7;
        relTol          0.01;

        smoother        DICGaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        nFinestSweeps   2;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
    }

    pFinal
    {
        $p;
        relTol          0;
    }

    "rho.*"
    {
        solver          diagonal;
    }

    "(U|h|e)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        nSweeps         2;
        tolerance       1e-7;
        relTol          0.1;
    }

    "(U|h|e)Final"
    {
        $U;
        relTol          0;
    }
}


PIMPLE
{
    momentumPredictor yes;
    // Subsonic (Mach < ~0.6): the pressure equation stays symmetric
    transonic         no;
    nOuterCorrectors  1;
    nCorrectors       2;
    // A non-orthogonal corrector (tetrahedra reach ~57 degrees) changed
    // nothing measurable here and cost 16% of the OpenFOAM time
    nNonOrthogonalCorrectors 0;
}

potentialFlow
{
    nNonOrthogonalCorrectors 0;

    PhiRefCell      0;
    PhiRefValue     0;
}


