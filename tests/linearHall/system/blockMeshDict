FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location system;
    object blockMeshDict;
}

convertToMeters 1;

// Geometry parameters for easy configuration
L   0.16;   // length in x-direction
h   0.08;   // height in y-direction
b   0.08;   // breadth in z-direction

vertices
(
    (0  0  0)
    ($L 0  0)
    ($L $h 0)
    (0  $h 0)
    (0  0  $b)
    ($L 0  $b)
    ($L $h $b)
    (0  $h $b)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (40 10 10) simpleGrading (1 1 1)
);

edges ();

boundary
(
    InletX
    {
        type patch;
        faces
        (
            (0 3 7 4)   // x = 0
        );
    }

    OutletX
    {
        type patch;
        faces
        (
            (1 2 6 5)   // x = L
        );
    }

    FaradayMinusY
    {
        type wall;
        faces
        (
            (0 1 5 4)   // y = 0
        );
    }

    FaradayPlusY
    {
        type wall;
        faces
        (
            (3 2 6 7)   // y = H
        );
    }

    SideWallsZ
    {
        type wall;
        faces
        (
            (0 1 2 3)   // z = 0
            (4 5 6 7)   // z = b
        );
    }
);

mergePatchPairs ();
