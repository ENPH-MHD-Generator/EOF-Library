Header
  CHECK KEYWORDS Fatal
  Mesh DB "." "meshElmer"
End

Simulation
  Coordinate System = String "Cartesian 3D"
  Simulation Type = Steady

  Steady State Max Iterations = 1000000
  Steady State Min Iterations = 1000000

  Output Intervals = 1
  Post File = case.ep
End


! -------------------------
! Bodies / Equation
! -------------------------
Equation 1
  Name = "Alloc_sigma"
  Active Solvers = 1
End

Equation 2
  Name = "Alloc_Ux"
  Active Solvers = 2
End

Equation 3
  Name = "Alloc_Uy"
  Active Solvers = 3
End

Equation 4
  Name = "Alloc_Uz"
  Active Solvers = 4
End

Equation 5
  Name = "Alloc_Bx"
  Active Solvers = 5
End

Equation 6
  Name = "Alloc_By"
  Active Solvers = 6
End

Equation 7
  Name = "Alloc_Bz"
  Active Solvers = 7
End

Equation 8
  Name = "OF_to_Elmer"
  Active Solvers = 8
End

Equation 9
  Name = "StaticCurrent"
  Active Solvers = 9
End

Equation 10
  Name = "Elmer_to_OF"
  Active Solvers = 10
End

! --------------------------------------------------
! Define Scalar Fields
! --------------------------------------------------

Solver 1
  Exec Solver = Before Simulation
  Equation = "Alloc_sigma"
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = String "Electric Conductivity"
  Variable DOFs = 1
End

Solver 2
  Exec Solver = Before Simulation
  Equation = "Alloc_Ux"
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = String "Ux"
  Variable DOFs = 1
End

Solver 3
  Exec Solver = Before Simulation
  Equation = "Alloc_Uy"
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = String "Uy"
  Variable DOFs = 1
End

Solver 4
  Exec Solver = Before Simulation
  Equation = "Alloc_Uz"
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = String "Uz"
  Variable DOFs = 1
End

Solver 5
  Exec Solver = Before Simulation
  Equation = "Alloc_Bx"
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = String "Bx"
  Variable DOFs = 1
End

Solver 6
  Exec Solver = Before Simulation
  Equation = "Alloc_By"
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = String "By"
  Variable DOFs = 1
End

Solver 7
  Exec Solver = Before Simulation
  Equation = "Alloc_Bz"
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = String "Bz"
  Variable DOFs = 1
End

! --------------------------------------------------
! OpenFOAM -> Elmer: populate scalar fields
! --------------------------------------------------

Solver 8
  Exec Solver = Always
  Equation = "OF_to_Elmer"
  Procedure = "OpenFOAM2Elmer" "OpenFOAM2ElmerSolver"

  Target Variable 1 = String "Electric Conductivity"
  Target Variable 2 = String "Ux"
  Target Variable 3 = String "Uy"
  Target Variable 4 = String "Uz"
  Target Variable 5 = String "Bx"
  Target Variable 6 = String "By"
  Target Variable 7 = String "Bz"
End

! --------------------------------------------------
! Static current solve (UxB handled internally)
! --------------------------------------------------
Solver 9
  Exec Solver = Always
  Equation = "StaticCurrent"
  Procedure = "MHDSolve" "StatCurrentSolver"

  Variable = Potential
  Variable DOFs = 1

  ! IncludeUxB = Logical True

  Calculate Volume Current = Logical True
  Calculate Joule Heating  = Logical True

  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Preconditioning = ILU0
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-10
End


! --------------------------------------------------
! Elmer -> OpenFOAM: export results
! --------------------------------------------------
Solver 10
  Exec Solver = Always
  Equation = "Elmer_to_OF"
  Procedure = "Elmer2OpenFOAM" "Elmer2OpenFOAMSolver"

  Target Variable 1 = String "Volume Current 1"
  Target Variable 2 = String "Volume Current 2"
  Target Variable 3 = String "Volume Current 3"

  Target Variable 4 = String "Joule Heating"

  ! TODO export potential back to OF:
  ! Target Variable 5 = String "PhiHall"
End

! -------------------------
! Material
! -------------------------
Material 1
  Name = "Conducting Fluid"

  Electric Conductivity = Variable "Electric Conductivity"
    Real MATC "tx"
End


! -------------------------
! Body Force
! -------------------------
Body 1
  Name = "fluid"
  Target Bodies(1) = 1
  Equation = 9      ! electrostatics equation
  Material = 1
  Body Force = 1
End


! -------------------------
! Boundary Conditions
! -------------------------
Boundary Condition 1
  ! FaradayMinusY (ground)
  Target Boundaries(1) = 1
  Potential = Real 0.0
End

Boundary Condition 2
  ! FaradayPlusY (current injection)
  Target Boundaries(1) = 2
  Potential = Real 10.0
End

Boundary Condition 3
  ! SideWallsZ
  Target Boundaries(1) = 5
  Current Density BC = Logical True
  Current Density = Real 0.0
End
