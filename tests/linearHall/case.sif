Header
  CHECK KEYWORDS Warn
  Mesh DB "." "meshElmer"
End

Simulation
  Coordinate System = String "Cartesian 3D"
  Simulation Type   = Steady State
  Steady State Max Iterations = 1
  Steady State Min Iterations = 1
  Output Intervals = 1
  Post File = case.ep
End

! -------------------------
! Bodies / Equation
! -------------------------
Body 1
  Name = "fluid"
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
  Body Force = 1
End

Equation 1
  Name = "EOF_HallChannel"
  Active Solvers(4) = 1 2 3 4
End

! --------------------------------------------------
! 1) Declare conductivity scalar provided by OpenFOAM
! --------------------------------------------------
Solver 1
  Exec Solver = Always
  Equation = "DeclareConductivity"
  Procedure = "AllocateSolver" "AllocateSolver"
  Variable = Electric Conductivity
  Variable DOFs = 1
End

! --------------------------------------------------
! 2) OpenFOAM → Elmer: fill OF Conductivity
! --------------------------------------------------
Solver 2
  Exec Solver = Always
  Equation = "OpenFOAM2Elmer"
  Procedure = "OpenFOAM2Elmer" "OpenFOAM2ElmerSolver"
  Target Variable 1 = String "Electric Conductivity"
End

! --------------------------------------------------
! 3) Static current solve for Potential (Hall via tensor conductivity)
! --------------------------------------------------
Solver 3
  Exec Solver = Always
  Equation = "Static Current Solver"
  Procedure = "StatCurrentSolve" "StatCurrentSolver"

  Variable = Potential
  Variable DOFs = 1

  Calculate Volume Current = Logical True
  Calculate Joule Heating  = Logical True

  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStab
  Linear System Preconditioning = ILU0
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-10
End


! --------------------------------------------------
! 4) Elmer → OpenFOAM: export computed current density components
!    (EOF naming: "Current Density 1/2/3" from derived fields)
! --------------------------------------------------
Solver 4
  Exec Solver = Always
  Equation = "Elmer2OpenFOAM"
  Procedure = "Elmer2OpenFOAM" "Elmer2OpenFOAMSolver"
  Target Variable 1 = Volume Current 1
  Target Variable 2 = Volume Current 2
  Target Variable 3 = Volume Current 3
  Target Variable 4 = Joule Heating

End



! -------------------------
! Material: Hall conductivity tensor for B || z
! Σ = [[σP,  σH, 0],
!      [-σH, σP, 0],
!      [0,    0, σ||]]
!
! σ|| = σ0
! σP  = σ0/(1+β^2)
! σH  = σ0*β/(1+β^2)
!
! σ0 comes from OpenFOAM via OF Conductivity.
! -------------------------
Material 1
  Name = "Conducting Fluid"

  Electric Conductivity = Variable Electric Conductivity
    Real MATC "tx"
End


! -------------------------
! Body Force: none for pure conduction
! -------------------------
Body Force 1
  Name = "NoSource"
End

Boundary Condition 1
  ! FaradayMinusY
  Target Boundaries(1) = 1
  Potential = Real 0.0
End

Boundary Condition 2
  ! FaradayPlusY
  Target Boundaries(1) = 2
  Potential = Real 1.0
End

Boundary Condition 3
  ! SideWallsZ
  Target Boundaries(1) = 5
  Current Density BC = Logical True
  Current Density = Real 0.0
End

