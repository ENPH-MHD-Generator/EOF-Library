FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      B;
}

// Magnetic flux density [Tesla]
dimensions      [1 0 -2 0 0 -1 0];

// Uniform magnetic field in +z direction
internalField   uniform (0 0 1.5);

// Boundary conditions, zero at boundaries

boundaryField
{
    InletX
    {
        type    zeroGradient;
    }

    OutletX
    {
        type    zeroGradient;
    }

    InsulatorSurface
    {
        type    zeroGradient;
    }

    CathodeSurface
    {
        type    zeroGradient;
    }

    AnodeSurface
    {
        type    zeroGradient;
    }


    defaultFaces
    {
        type    zeroGradient;
    }

}

