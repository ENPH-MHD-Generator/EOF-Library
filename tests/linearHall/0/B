FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      B;
}

// Magnetic flux density [Tesla]
dimensions      [1 0 -2 0 0 -1 0];

// Uniform magnetic field in +z direction
internalField   uniform (0 0 1);

// Boundary conditions, zero at boundaries
boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            zeroGradient;
    }

    defaultFaces
    {
        type            zeroGradient;
    }
}
