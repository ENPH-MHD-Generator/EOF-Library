FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      electric_field;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Electric field E = -grad(Potential) [V/m]
dimensions [1 1 -3 0 0 -1 0];

// Start from zero; computed from potential gradient during coupling
internalField   uniform (0 0 0);

boundaryField
{
    InletX
    {
        type    zeroGradient;
    }

    OutletX
    {
        type    zeroGradient;
    }

    FaradayMinusY
    {
        type    zeroGradient;
    }

    FaradayPlusY
    {
        type    zeroGradient;
    }

    SideWallsZ
    {
        type    zeroGradient;
    }

    defaultFaces
    {
        type    zeroGradient;
    }
}

