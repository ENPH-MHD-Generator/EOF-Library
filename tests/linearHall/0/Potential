FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Potential;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Electric potential [V]
dimensions [1 2 -3 0 0 -1 0];

// Start from zero; Elmer overwrites this during coupling
internalField   uniform 0;


boundaryField
{
    InletX
    {
        type    zeroGradient;
    }

    OutletX
    {
        type    zeroGradient;
    }

    InsulatorSurface
    {
        type    zeroGradient;
    }

    CathodeSurface_1
    {
        type    zeroGradient;
    }

    AnodeSurface_1
    {
        type    zeroGradient;
    }

    CathodeSurface_2
    {
        type    zeroGradient;
    }

    AnodeSurface_2
    {
        type    zeroGradient;
    }

    CathodeSurface_3
    {
        type    zeroGradient;
    }

    AnodeSurface_3
    {
        type    zeroGradient;
    }

    CathodeSurface_4
    {
        type    zeroGradient;
    }

    AnodeSurface_4
    {
        type    zeroGradient;
    }


    defaultFaces
    {
        type    zeroGradient;
    }

}


