FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.melt;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

// For the linear Hall test we treat the whole domain as conducting,
// so the melt fraction is initially 1 everywhere.
internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 1;
    }

    walls
    {
        type            fixedValue;
        value           uniform 1;
    }
}


// ************************************************************************* //


