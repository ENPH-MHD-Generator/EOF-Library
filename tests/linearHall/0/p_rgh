FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Dynamic pressure (p - rho*g*h)
dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;


boundaryField
{
    InletX
    {
        type    zeroGradient;
    }

    OutletX
    {
        type fixedValue;
        value uniform 0;
    }

    InsulatorSurface
    {
        type    zeroGradient;
    }

    CathodeSurface
    {
        type    zeroGradient;
    }

    AnodeSurface
    {
        type    zeroGradient;
    }


    defaultFaces
    {
        type    zeroGradient;
    }

}



