FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];   // Temperature in Kelvin
internalField   uniform 2500;

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform 2500;   // 2500 K argon inlet
    }

    outlet
    {
        type zeroGradient;
    }

    walls
    {
        type fixedValue;
        value uniform 2500;   // Isothermal walls at 2500 K
    }
}


