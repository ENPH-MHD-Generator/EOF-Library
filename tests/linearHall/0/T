/*--------------------------------*- C++ -*----------------------------------*\
  Temperature field for mhdThermoInterFoam5 (argon plasma)
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}

// Temperature [K]
dimensions      [0 0 0 1 0 0 0];

internalField   uniform 100;


boundaryField
{
    InletX
    {
        type    fixedValue;
        value   uniform 1500;
    }

    OutletX
    {
        type    zeroGradient;
    }

    InsulatorSurface
    {
        type    zeroGradient;
    }

    CathodeSurface_1
    {
        type    zeroGradient;
    }

    AnodeSurface_1
    {
        type    zeroGradient;
    }

    CathodeSurface_2
    {
        type    zeroGradient;
    }

    AnodeSurface_2
    {
        type    zeroGradient;
    }

    CathodeSurface_3
    {
        type    zeroGradient;
    }

    AnodeSurface_3
    {
        type    zeroGradient;
    }

    CathodeSurface_4
    {
        type    zeroGradient;
    }

    AnodeSurface_4
    {
        type    zeroGradient;
    }


    defaultFaces
    {
        type    zeroGradient;
    }

}

