/*--------------------------------*- C++ -*----------------------------------*\
  Temperature field for mhdThermoInterFoam5 (argon plasma)
\*---------------------------------------------------------------------------*/

FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}

// Temperature [K]
dimensions      [0 0 0 1 0 0 0];

internalField   uniform 500;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 2000;
    }

    outlet
    {
        type            zeroGradient;
    }

    walls
    {
        type            zeroGradient;     // or fixedValue if cooled/heated
        // type            fixedValue;
        // value           uniform 300;   // Example cooled walls
    }

    defaultFaces
    {
        type empty;   // only if 2D axisymmetric or 2D planar mesh (adjust as needed)
    }
}
