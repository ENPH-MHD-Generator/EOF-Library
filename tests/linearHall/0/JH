FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      JH;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Joule heating power density [W/m^3]
dimensions [1 -1 -3 0 0 0 0];

internalField   uniform 0;


boundaryField
{
    InletX
    {
        type    zeroGradient;
    }

    OutletX
    {
        type    zeroGradient;
    }

    InsulatorSurface
    {
        type    zeroGradient;
    }

    CathodeSurface_1
    {
        type    zeroGradient;
    }

    AnodeSurface_1
    {
        type    zeroGradient;
    }

    CathodeSurface_2
    {
        type    zeroGradient;
    }

    AnodeSurface_2
    {
        type    zeroGradient;
    }

    CathodeSurface_3
    {
        type    zeroGradient;
    }

    AnodeSurface_3
    {
        type    zeroGradient;
    }

    CathodeSurface_4
    {
        type    zeroGradient;
    }

    AnodeSurface_4
    {
        type    zeroGradient;
    }

    defaultFaces
    {
        type    zeroGradient;
    }
}


