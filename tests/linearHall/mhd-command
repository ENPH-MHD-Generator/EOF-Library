#!/usr/bin/env bash
# `mhd` inside the application image: case preparation and runs.

# Ensure direct calls have the same solver environment as an interactive shell.
# The solver image provides the Elmer and EOF library paths; OpenFOAM's bashrc
# provides its own.
arguments=("$@")
set --
source /opt/openfoam6/etc/bashrc

LINEAR_HALL_HOME="${LINEAR_HALL_HOME:-/opt/linear-hall}"
cd "$LINEAR_HALL_HOME"
exec "$LINEAR_HALL_HOME/env/venv/bin/python3" -m caseprep "${arguments[@]}"
