sinclude $(GENERAL_RULES)/mplib$(WM_MPLIB)
sinclude $(RULES)/mplib$(WM_MPLIB)

FOAM_VERSION_RAW   = $(firstword $(subst ., ,$(WM_PROJECT_VERSION)))
FOAM_VERSION_NUM   = $(patsubst v%,%,$(FOAM_VERSION_RAW))
FOAM_MAJOR_VERSION = $(FOAM_VERSION_NUM)

PFLAGS_ALL = $(PFLAGS) $(PINC)

ifeq ($(FOAM_VERSION_RAW),v1812)
    $(info ************  OF version v1812 ************)
    EOF_LIBS = -L$(FOAM_USER_LIBBIN) -lPstream
    EOF_INC = -I../commSplit/lnInclude
    DYN_INC = -I$(LIB_SRC)/dynamicFvMesh/lnInclude
    DYN_LIBS = -ldynamicFvMesh
    FVOPT_LIBS = -lfvOptions
else
    ifeq ($(shell test $(FOAM_VERSION_NUM) -lt 6; echo $$?),0)
        $(info ************  OF version <6 ************)
        EOF_LIBS = -L$(FOAM_USER_LIBBIN) -lPstream
        EOF_INC = -I../commSplit/lnInclude
    else
        $(info ************  OF version $(FOAM_VERSION_RAW) / numeric $(FOAM_VERSION_NUM) ************)
        EOF_INC = -I$(LIB_SRC)/Pstream/mpi/lnInclude
    endif

    ifeq ($(shell test $(FOAM_VERSION_NUM) -lt 9; echo $$?),0)
        $(info ************  OF version <9 ************)
        FVOPT_LIBS = -lfvOptions
    endif

    ifeq ($(shell test $(FOAM_VERSION_NUM) -lt 10; echo $$?),0)
        $(info ************  OF version <10 ************)
        DYN_INC = -I$(LIB_SRC)/dynamicFvMesh/lnInclude
        DYN_LIBS = -ldynamicFvMesh
    endif

    ifeq ($(shell test $(FOAM_VERSION_NUM) -ge 11; echo $$?),0)
        $(info ************  OF version >=11 ************)
        PFLAGS_ALL = $(PFLAGS) $(PINC)
    endif
endif

EXE_INC  = \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    $(DYN_INC) \
    -I$(LIB_SRC)/meshTools/lnInclude \
    $(PFLAGS_ALL) \
    -DFOAM_MAJOR_VERSION=$(FOAM_VERSION_NUM) \
    -Wno-old-style-cast \
    $(EOF_INC)

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    $(DYN_LIBS) \
    $(FVOPT_LIBS) \
    $(EOF_LIBS)
