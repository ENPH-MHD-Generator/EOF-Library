sinclude $(GENERAL_RULES)/mplib$(WM_MPLIB)
sinclude $(RULES)/mplib$(WM_MPLIB)

FOAM_VERSION_RAW   = $(firstword $(subst ., ,$(WM_PROJECT_VERSION)))
FOAM_VERSION_NUM   = $(patsubst v%,%,$(FOAM_VERSION_RAW))
FOAM_MAJOR_VERSION = $(FOAM_VERSION_NUM)

ifeq ($(EOF_SRC),)
    $(info EOF_SRC is not set, trying default location..)
    EOF_BASE = ../../libs
else
    EOF_BASE = $(EOF_SRC)
endif

EOF_INC = \
    -I$(EOF_BASE)/coupleElmer/lnInclude

ifeq ($(shell test $(FOAM_VERSION_NUM) -lt 6; echo $$?),0)
    $(info ************  OF version <6 ************)
    EOF_LIBS = -lPstream
    EOF_INC += -I$(EOF_BASE)/commSplit/lnInclude
else
    $(info ************  OF version $(FOAM_VERSION_RAW) / numeric $(FOAM_VERSION_NUM) ************)
    EOF_LIBS =
    EOF_INC += -I$(LIB_SRC)/Pstream/mpi/lnInclude
endif

EXE_INC = \
    -I$(LIB_SRC)/TurbulenceModels/turbulenceModels/lnInclude \
    -I$(LIB_SRC)/TurbulenceModels/incompressible/lnInclude \
    -I$(LIB_SRC)/transportModels \
    -I$(LIB_SRC)/transportModels/incompressible/singlePhaseTransportModel \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I$(LIB_SRC)/sampling/lnInclude \
    $(EOF_INC) \
    $(PFLAGS) $(PINC)

EXE_LIBS = \
    -lturbulenceModels \
    -lincompressibleTurbulenceModels \
    -lincompressibleTransportModels \
    -lfiniteVolume \
    -lfvOptions \
    -lmeshTools \
    -lsampling \
    -L$(FOAM_USER_LIBBIN) \
    $(EOF_LIBS) \
    -lElmer
