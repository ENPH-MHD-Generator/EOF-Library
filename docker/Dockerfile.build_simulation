FROM eoflibrary/eof_elmer84_of6:latest

USER root

# Tools (combine apt calls into one layer)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nano strace sudo \
 && rm -rf /var/lib/apt/lists/*

# Allow openfoam user to sudo without password
RUN echo "openfoam ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/openfoam \
 && chmod 0440 /etc/sudoers.d/openfoam

WORKDIR /home/openfoam

# Remove the EOF-Library that ships inside the base image (if present)
RUN rm -rf /home/openfoam/EOF-Library \
 && mkdir -p /home/openfoam/EOF-Library

# Copy your fork into the container (preserve directory structure)
COPY libs/     /home/openfoam/EOF-Library/libs/
COPY solvers/  /home/openfoam/EOF-Library/solvers/
COPY etc/      /home/openfoam/EOF-Library/etc/
COPY tests/    /home/openfoam/EOF-Library/tests/
COPY Makefile  /home/openfoam/EOF-Library/Makefile

# # Ensure openfoam owns the working tree (critical for wmake outputs)
# RUN chown -R openfoam:openfoam /home/openfoam/EOF-Library

# ---- Build OpenFOAM-facing pieces as openfoam (so binaries land in openfoam FOAM_USER_APPBIN)
# USER openfoam
WORKDIR /home/openfoam/EOF-Library

RUN make eof
RUN make solver
RUN make simulation

# Ensure interactive shells know OpenFOAM + EOF env (helps aliases & PATH)
RUN echo '. /opt/openfoam6/etc/bashrc' >> /home/openfoam/.bashrc \
 && echo '. /home/openfoam/EOF-Library/etc/bashrc' >> /home/openfoam/.bashrc

# ---- Build / install Elmer solver bits as root (writes under /opt/elmerfem and installs)
WORKDIR /home/openfoam/EOF-Library

RUN make elmer

# Aliases (for interactive use)
RUN echo 'alias run_sim="cd ~/EOF-Library/runs/linearHall && mpirun -n 2 mdhLinearHall -parallel : -n 2 ElmerSolver_mpi case.sif"' >> /home/openfoam/.bashrc \
 && echo 'alias finish_up="reconstructPar -case . && foamToVTK -case ."' >> /home/openfoam/.bashrc \
 && echo 'alias run_all="run_sim && finish_up"' >> /home/openfoam/.bashrc

