+    ! Solve with the factors, rg in the global numbering; the solution is left
+    ! in RHS on all partitions
+    SUBROUTINE MumpsSolve( r )
+      REAL(KIND=dp) :: r(:)
+      A % MumpsID % RHS = r
+      A % MumpsID % job = 3
+      CALL DMumps(A % MumpsID)
+      CALL MumpsCheck('solution')
+      A % MumpsId % Rhs = 0
+      DO i=1,A % MumpsID % lsol_loc
+        A % MumpsID % RHS(A % MumpsID % isol_loc(i)) = A % MumpsID % sol_loc(i)
+      END DO
+      dbuf = A % MumpsId % RHS
+      CALL MPI_ALLREDUCE( dbuf, A % MumpsID % RHS, A % MumpsID % n, &
+          MPI_DOUBLE_PRECISION, MPI_SUM, A % MumpsID % Comm, ierr )
+    END SUBROUTINE MumpsSolve
+
+    ! w = A u in the global numbering
+    SUBROUTINE GlobalMatVec( u, w )
+      REAL(KIND=dp) :: u(:), w(:)
+      INTEGER :: k
+      REAL(KIND=dp) :: s
+      dbuf = 0.0_dp
+      DO k=1,A % NumberOfRows
+        s = 0.0_dp
+        DO j=A % Rows(k),A % Rows(k+1)-1
+          s = s + A % Values(j) * u(A % Gorder(A % Cols(j)))
+        END DO
+        dbuf(A % Gorder(k)) = dbuf(A % Gorder(k)) + s
+      END DO
+      CALL MPI_ALLREDUCE( dbuf, w, A % MumpsID % n, &
+          MPI_DOUBLE_PRECISION, MPI_SUM, A % MumpsID % Comm, ierr )
+    END SUBROUTINE GlobalMatVec
+
+    ! GMRES(m) for A xg = bg from xg, right-preconditioned with the factors,
+    ! until |bg - A xg| <= RefineTol |bg|. rg holds the final residual.
+    SUBROUTINE Gmres( Conv )
+      LOGICAL :: Conv
+      INTEGER, PARAMETER :: m = 20
+      REAL(KIND=dp), ALLOCATABLE :: V(:,:), w(:)
+      REAL(KIND=dp) :: H(m+1,m), cs(m), sn(m), g(m+1), y(m), beta, tmp
+      INTEGER :: k, l, kk
+
+      ALLOCATE( V(SIZE(bg),m+1), w(SIZE(bg)) )
+      Conv = .FALSE.
+      RefineIters = 0
+      DO
+        CALL GlobalMatVec( xg, w )
+        rg = bg - w
+        beta = SQRT( SUM(rg**2) )
+        IF ( beta <= RefineTol * bnorm ) THEN
+          Conv = .TRUE.
+          EXIT
+        END IF
+        IF ( RefineIters >= RefineMaxIter ) EXIT
+
+        V(:,1) = rg / beta
+        g = 0.0_dp
+        g(1) = beta
+        kk = 0
+        DO k = 1, m
+          CALL MumpsSolve( V(:,k) )
+          CALL GlobalMatVec( A % MumpsID % RHS, w )
+          DO l = 1, k
+            H(l,k) = DOT_PRODUCT( w, V(:,l) )
+            w = w - H(l,k) * V(:,l)
+          END DO
+          H(k+1,k) = SQRT( SUM(w**2) )
+          IF ( H(k+1,k) > 0.0_dp ) V(:,k+1) = w / H(k+1,k)
+          DO l = 1, k-1
+            tmp = cs(l) * H(l,k) + sn(l) * H(l+1,k)
+            H(l+1,k) = -sn(l) * H(l,k) + cs(l) * H(l+1,k)
+            H(l,k) = tmp
+          END DO
+          tmp = SQRT( H(k,k)**2 + H(k+1,k)**2 )
+          cs(k) = H(k,k) / tmp
+          sn(k) = H(k+1,k) / tmp
+          H(k,k) = tmp
+          H(k+1,k) = 0.0_dp
+          g(k+1) = -sn(k) * g(k)
+          g(k) = cs(k) * g(k)
+          kk = k
+          RefineIters = RefineIters + 1
+          IF ( ABS(g(k+1)) <= 0.5_dp * RefineTol * bnorm .OR. &
+              RefineIters >= RefineMaxIter ) EXIT
+        END DO
+
+        DO l = kk, 1, -1
+          y(l) = ( g(l) - DOT_PRODUCT( H(l,l+1:kk), y(l+1:kk) ) ) / H(l,l)
+        END DO
+        w = MATMUL( V(:,1:kk), y(1:kk) )
+        CALL MumpsSolve( w )
+        xg = xg + A % MumpsID % RHS
+      END DO
+      DEALLOCATE( V, w )
+    END SUBROUTINE Gmres
