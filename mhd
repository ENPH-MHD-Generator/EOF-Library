#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE_NAME="mhd-sim"
IMAGE_REFERENCE="${IMAGE_NAME}:latest"

usage() {
  cat <<'EOF'
Usage: ./mhd <command> [options]

Commands:
  build [--debug]  Build the MHD solver image.
  shell            Start the existing image with experiments/ and out/ mounted.
  start [--debug]  Build the image, then start a shell.
  help             Show this help.

Case commands are available inside the container:
  mhd prepare --list
  mhd prepare /experiments/linear-hall.yaml [--name NAME] [--mesh]
  mhd run --list
  mhd run NAME
EOF
}

build_image() {
  local debug=0
  if [[ "${1:-}" == "--debug" ]]; then
    debug=1
    shift
  fi
  if [[ $# -ne 0 ]]; then
    echo "Unexpected build argument: $1" >&2
    usage >&2
    exit 2
  fi
  make -C "$PROJECT_DIR" build IMAGE_NAME="$IMAGE_NAME" ELMER_DEBUG="$debug"
}

start_shell() {
  mkdir -p "$PROJECT_DIR/experiments" "$PROJECT_DIR/out"
  if ! docker image inspect "$IMAGE_REFERENCE" >/dev/null 2>&1; then
    echo "Image '$IMAGE_REFERENCE' does not exist. Run './mhd build' first." >&2
    exit 2
  fi
  docker run --rm -it \
    --platform linux/amd64 \
    -e HOST_USER_ID="$(id -u)" \
    -e HOST_USER_GID="$(id -g)" \
    -v "$PROJECT_DIR/experiments:/experiments:ro" \
    -v "$PROJECT_DIR/out:/runs" \
    "$IMAGE_REFERENCE"
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  build)
    build_image "$@"
    ;;
  shell)
    if [[ $# -ne 0 ]]; then
      echo "The shell command does not accept arguments." >&2
      exit 2
    fi
    start_shell
    ;;
  start)
    build_image "$@"
    start_shell
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
